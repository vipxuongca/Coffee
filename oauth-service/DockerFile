# ---- Build Stage ----
FROM golang:1.23-alpine AS builder

WORKDIR /app

# Download dependencies first (cache layer)
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build statically
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o main .

# ---- Run Stage ----
FROM alpine:latest

WORKDIR /app

# Copy the built binary
COPY --from=builder /app/main .

EXPOSE 4001

CMD ["./main"]
